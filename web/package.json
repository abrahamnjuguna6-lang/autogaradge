{
  "name": "autobridge-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "validate": "node scripts/validate.js",
    "validate:all": "for f in $(find src/components src/pages -name \"*.tsx\"); do node scripts/validate.js \"$f\" > /dev/null || { node scripts/validate.js \"$f\"; exit 1; }; done && echo \"All components valid\"",
    "check": "tsc -b && npm run lint && npm run validate:all"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@swc/core": "^1.16.20",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
